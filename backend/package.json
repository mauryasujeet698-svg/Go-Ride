{
  "name": "@go-ride/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Go-Ride shared ride-hailing API",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/domain/ride-state.test.js dist/config/features.test.js dist/server.test.js dist/payments/webhook-signature.test.js dist/payments/razorpay.test.js dist/auth/jwt.test.js dist/auth/fastify-auth.test.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "zod": "^3.24.2",
    "jose": "^6.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
