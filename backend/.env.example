# Copy to .env locally. Never commit real secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
DATABASE_URL=postgres://goride:replace_me@localhost:5432/goride
DATABASE_SSL=false
CORS_ORIGINS=http://localhost:3000
# Public capability flags are presentation hints; every action is enforced server-side.
FEATURE_PAYMENTS_ENABLED=false
FEATURE_PAYMENTS_MODE=disabled
FEATURE_PAYMENT_UPI_ENABLED=false
FEATURE_PAYMENT_CARDS_ENABLED=false
FEATURE_PAYMENT_NETBANKING_ENABLED=false
FEATURE_PAYMENT_CASH_ENABLED=false
FEATURE_MAP_SEARCH_ENABLED=false
FEATURE_ROUTING_ENABLED=false
ROUTING_BASE_URL=
FARE_BASE_MINOR=3000
FARE_PER_KM_MINOR=1200
FARE_PER_MINUTE_MINOR=200
FARE_MINIMUM_MINOR=5000
FARE_CURRENCY=INR
FARE_POLICY_VERSION=launch-v1
FEATURE_DRIVER_DISPATCH_ENABLED=false
FEATURE_CUSTOMER_SUPPORT_ENABLED=false
FEATURE_DRIVER_SUPPORT_ENABLED=false
FEATURE_SAFETY_SOS_ENABLED=false
# Identity provider validation settings. Protected routes must fail closed if these are absent.
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
# Provider secrets are configured only in a secret manager/environment, never in app config.
RIDE_PIN_SECRET=
PAYMENT_PROVIDER=none
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SECRET=
